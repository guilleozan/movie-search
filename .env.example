# Frontend (.env.local). Get both from `npx supabase status` locally,
# or Project Settings > API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets. Hosted: `npx supabase secrets set NAME=value`.
# Local: put them in supabase/functions/.env (gitignored). Never in .env.local.
TMDB_READ_TOKEN=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
SHOWTIMES_PROVIDER=links
SHOWTIMES_API_KEY=
OSM_CONTACT=
# Alerts: shared secret for the daily cron call (also stored in Vault, see README).
ALERTS_SECRET=
# Optional alert emails via Resend; APP_URL is the site the links point to.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=

# Local Google sign-in only (supabase/.env, read by `supabase start`).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
