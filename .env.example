# Frontend (.env.local). Get both from `npx supabase status` locally,
# or Project Settings > API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase secrets (set with `npx supabase secrets set NAME=value`, never in .env.local).
# Used by Edge Functions from Phase 2 onwards.
TMDB_READ_TOKEN=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
SHOWTIMES_PROVIDER=links
SHOWTIMES_API_KEY=

# Local Google sign-in only (supabase/.env, read by `supabase start`).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
